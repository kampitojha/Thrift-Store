NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# LOCAL PostgreSQL (your installed Postgres — NOT Docker)
# Default Windows install: port 5432
DATABASE_URL=postgresql://reloom:reloom_secret@127.0.0.1:5432/reloom?schema=public
# Or use superuser temporarily:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/reloom?schema=public

REDIS_URL=redis://localhost:6380
REDIS_PREFIX=reloom:

MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=reloom_meili_master_dev_key_change_me
MEILI_INDEX_PRODUCTS=products

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

PLATFORM_COMMISSION_BPS=1000
FEATURE_AI_LISTING=true
FEATURE_COD=true
FEATURE_OFFERS=true
